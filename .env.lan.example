# Configuração do servidor Pulyn para operação sem internet na rede local
DB_DRIVER=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=pulyn
PGUSER=postgres
PGPASSWORD=defina-aqui
DB_SSL=false
DB_TIMEOUT=30000
PG_POOL_MAX=10

HOST=0.0.0.0
PORT=3001
NODE_ENV=production
JWT_SECRET=gere-um-segredo-local-longo
FRONTEND_URL=http://192.168.0.60:3001
