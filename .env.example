# ==========================================
# 📋 ARQUIVO DE EXEMPLO - NÃO EDITAR DIRETAMENTE
# Use este arquivo como template para criar .env local
# ==========================================

# === AMBIENTE ===
# production | staging | development
NODE_ENV=development
PORT=3001

# === JWT - Segredo para assinar tokens ===
# ⚠️ PRODUÇÃO: Use uma string aleatória e complexa (min 32 chars)
# 🏠 LOCAL: Pode ser simples para desenvolvimento
JWT_SECRET=seu-segredo-jwt-aqui

# === DATABASE - Escolha UMA configuração ===

# --- OPÇÃO 1: PostgreSQL (Supabase, Render, Railway, etc) ---
DB_DRIVER=postgres
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
DB_TIMEOUT=30000

# --- OPÇÃO 2: SQL Server Local (Desenvolvimento puro) ---
# DB_DRIVER=sqlserver
# DB_SERVER=localhost\SQLEXPRESS
# DB_NAME=PulynDB
# DB_USER=sa
# DB_PASSWORD=sua-senha-local
# DB_TIMEOUT=30000

# === FRONTEND URL ===
# Usada para gerar links de convite familiar
FRONTEND_URL=http://localhost:5173

# ==========================================
# 📌 INSTRUÇÕES DE CONFIGURAÇÃO
# ==========================================

# 1️⃣ DESENVOLVIMENTO LOCAL (Supabase)
#    - Copie este arquivo para: .env.local
#    - Configure DB_DRIVER=postgres
#    - Cole a URL do Supabase em DATABASE_URL
#    - Deixe NODE_ENV=development

# 2️⃣ DESENVOLVIMENTO LOCAL (SQL Server)
#    - Copie este arquivo para: .env.local
#    - Configure DB_DRIVER=sqlserver
#    - Preencha DB_SERVER, DB_NAME, DB_USER, DB_PASSWORD
#    - Deixe NODE_ENV=development

# 3️⃣ PRODUÇÃO
#    ⚠️ NUNCA faça commit do .env em produção
#    - Configure variáveis de ambiente no seu host:
#      • Heroku: via Config Vars
#      • Railway/Render: Environment Variables
#      • Docker: via ENV no Dockerfile
#      • VPS: exportar em .bashrc ou systemd
#    - Exemplo para Heroku CLI:
#      heroku config:set NODE_ENV=production
#      heroku config:set JWT_SECRET=seu-segredo-complexo
#      heroku config:set DATABASE_URL=postgresql://...
