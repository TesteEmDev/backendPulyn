# Configuração do Banco de Dados
# Copie este arquivo para .env e atualize os valores

# Nome do servidor SQL Server
# Opções comuns:
#   - localhost (mais comum)
#   - 127.0.0.1
#   - PC-DIOGO\SQLEXPRESS02 (nome específico da sua máquina)
#   - . (ponto = servidor local)
DB_SERVER=localhost

# Nome do banco de dados
DB_NAME=PulynDB

# Usuário do SQL Server
# Padrão é 'sa' (System Administrator)
DB_USER=sa

# Senha do SQL Server
DB_PASSWORD=123456

# Timeout de conexão em milissegundos
# Aumente se tiver problemas de timeout
DB_TIMEOUT=30000

# Porta da API
PORT=3001

# Ambiente
NODE_ENV=development
