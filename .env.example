# Driver atual: sqlserver (padrão) ou postgres
DB_DRIVER=sqlserver

# SQL Server local
DB_SERVER=localhost
DB_NAME=PulynDB
DB_USER=sa
DB_PASSWORD=defina-uma-senha-local

# SQL Server de origem para exportar o schema (preencha somente quando necessário)
# SOURCE_DB_SERVER=localhost\SQLEXPRESS
# SOURCE_DB_NAME=PulynDB
# SOURCE_DB_USER=sa
# SOURCE_DB_PASSWORD=defina-aqui

# PostgreSQL/Supabase
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
# SUPABASE_DB_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
# DB_SSL=true
# PG_POOL_MAX=10

DB_TIMEOUT=30000
PORT=3001
NODE_ENV=development
JWT_SECRET=defina-um-segredo-longo-e-aleatorio
